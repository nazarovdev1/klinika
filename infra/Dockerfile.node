# Builds api or worker:  docker build -f infra/Dockerfile.node --build-arg APP=api .
# NOTE: not verified locally (Docker unavailable on the dev machine) - verified in CI/first compose run.
FROM node:22-alpine AS build
ARG APP
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @shifo/${APP}... build
RUN pnpm --filter @shifo/${APP} deploy --prod /out

FROM node:22-alpine
ARG APP
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out/ ./
USER node
CMD ["node", "dist/index.js"]
