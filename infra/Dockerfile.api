# One image for the API, the background worker and the one-shot migration job:
#   api:     node dist/index.js      (default)
#   worker:  node dist/worker.js
#   migrate: see CMD in docker-compose.yml (prisma migrate deploy)
# Debian (not Alpine): Playwright's Chromium (PDF rendering) needs glibc and system libraries.
# NOTE: not verified locally (the Docker daemon was unavailable on the dev machine); the CI job
# `docker-build` and the first `docker compose up` are the verification.
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @shifo/api... build
RUN pnpm --filter @shifo/api deploy --prod /out

FROM node:22-bookworm-slim
ENV NODE_ENV=production PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
COPY --from=build /out/ ./
# Chromium + its OS dependencies, installed once into a shared path readable by the unprivileged user.
RUN npx --no-install playwright install --with-deps chromium \
  && rm -rf /var/lib/apt/lists/* \
  && chmod -R a+rX /ms-playwright
USER node
EXPOSE 4000
CMD ["node", "dist/index.js"]
