# Copy to .env. The API and worker refuse to start if required values are missing/invalid.
NODE_ENV=development
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://shifo:change-me@localhost:5432/shifo
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
LOG_LEVEL=info
# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Production only: public domain for Caddy automatic TLS
SITE_ADDRESS=:80

# Auth tuning (defaults shown)
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
LOGIN_RATE_LIMIT=5
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
COOKIE_SECURE=false

# PII encryption (AES-256-GCM, key rotation via several ids) and HMAC key. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_KEYS=k1:CHANGE_ME_BASE64_32_BYTES
PII_ACTIVE_KEY_ID=k1
PII_HMAC_KEY=CHANGE_ME_BASE64_AT_LEAST_32_BYTES

# Production (compose) extras
# DHP: mock (default) or http (needs DHP_BASE_URL; real auth is TODO(external-spec))
DHP_MODE=mock
DHP_BASE_URL=
# SMS: mock (default) or eskiz (stub until the Eskiz spec is available)
SMS_MODE=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Row-level security: DB_RLS=on needs DATABASE_URL = restricted role (shifo_app) and DATABASE_SYSTEM_URL = owner role (infra/db/roles.sql)
DB_RLS=off
DATABASE_SYSTEM_URL=
BACKUP_KEEP_DAYS=14
