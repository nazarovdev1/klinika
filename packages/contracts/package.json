    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@shifo/config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
