generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// Phase 1 models. Later phases add patients, scheduling, billing, ...
// Every tenant-owned model has clinicId (NOT NULL, indexed). See src/tenancy.ts.

enum Role {
  OWNER
  ADMIN
  REGISTRAR
  DOCTOR
  NURSE
  CASHIER
  LAB
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
  DEAD
}

model Clinic {
  id                String       @id @default(uuid()) @db.Uuid
  name              String
  legalName         String?
  inn               String?
  licenseNumber     String?
  phone             String?
  address           String?
  logoUrl           String?
  dhpOrganizationId String?
  settings          Json         @default("{}")
  status            ClinicStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  branches Branch[]
  users    User[]
}

model Branch {
  id            String   @id @default(uuid()) @db.Uuid
  clinicId      String   @db.Uuid
  name          String
  address       String?
  phone         String?
  timezone      String   @default("Asia/Tashkent")
  screenToken   String   @unique @default(uuid())
  dhpLocationId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic Clinic       @relation(fields: [clinicId], references: [id])
  users  UserBranch[]

  @@index([clinicId])
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  clinicId           String    @db.Uuid
  fullName           String
  phone              String
  login              String    @unique
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  version            Int       @default(1)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  branches      UserBranch[]
  doctorProfile DoctorProfile?
  refreshTokens RefreshToken[]

  @@unique([clinicId, phone])
  @@index([clinicId])
}

model UserBranch {
  id       String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  userId   String @db.Uuid
  branchId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([userId, branchId])
  @@index([clinicId])
}

model DoctorProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  clinicId           String   @db.Uuid
  userId             String   @unique @db.Uuid
  specialty          String
  cabinet            String?
  licenseNumber      String?
  color              String   @default("#0f766e")
  defaultSlotMinutes Int      @default(20)
  dhpPractitionerId  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([clinicId])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  clinicId     String    @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([familyId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clinicId, createdAt])
  @@index([clinicId, entityType, entityId])
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  clinicId    String       @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  availableAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([clinicId])
  @@index([status, availableAt])
}

model IdempotencyKey {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  key       String
  response  Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, key])
  @@index([clinicId])
}

model NumberSequence {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  branchId  String?  @db.Uuid
  key       String
  date      String   @default("")
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, branchId, key, date])
  @@index([clinicId])
}
