generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// Phase 1 models. Later phases add patients, scheduling, billing, ...
// Every tenant-owned model has clinicId (NOT NULL, indexed). See src/tenancy.ts.

enum Role {
  OWNER
  ADMIN
  REGISTRAR
  DOCTOR
  NURSE
  CASHIER
  LAB
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
  DEAD
}

model Clinic {
  id                String       @id @default(uuid()) @db.Uuid
  name              String
  legalName         String?
  inn               String?
  licenseNumber     String?
  phone             String?
  address           String?
  logoUrl           String?
  dhpOrganizationId String?
  settings          Json         @default("{}")
  status            ClinicStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  branches Branch[]
  users    User[]
  patients Patient[]
}

model Branch {
  id            String   @id @default(uuid()) @db.Uuid
  clinicId      String   @db.Uuid
  name          String
  address       String?
  phone         String?
  timezone      String   @default("Asia/Tashkent")
  screenToken   String   @unique @default(uuid())
  dhpLocationId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic Clinic       @relation(fields: [clinicId], references: [id])
  users  UserBranch[]

  @@index([clinicId])
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  clinicId           String    @db.Uuid
  fullName           String
  phone              String
  login              String    @unique
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  version            Int       @default(1)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  branches      UserBranch[]
  doctorProfile DoctorProfile?
  refreshTokens RefreshToken[]

  @@unique([clinicId, phone])
  @@index([clinicId])
}

model UserBranch {
  id       String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  userId   String @db.Uuid
  branchId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([userId, branchId])
  @@index([clinicId])
}

model DoctorProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  clinicId           String   @db.Uuid
  userId             String   @unique @db.Uuid
  specialty          String
  cabinet            String?
  licenseNumber      String?
  color              String   @default("#0f766e")
  defaultSlotMinutes Int      @default(20)
  dhpPractitionerId  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([clinicId])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  clinicId     String    @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([familyId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clinicId, createdAt])
  @@index([clinicId, entityType, entityId])
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  clinicId    String       @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  availableAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([clinicId])
  @@index([status, availableAt])
}

model IdempotencyKey {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  key       String
  response  Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, key])
  @@index([clinicId])
}

model NumberSequence {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  branchId  String?  @db.Uuid
  key       String
  date      String   @default("")
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, branchId, key, date])
  @@index([clinicId])
}

enum Sex {
  MALE
  FEMALE
}

enum ConsentType {
  DATA_PROCESSING
  DHP_SHARING
  SMS
}

model Patient {
  id            String    @id @default(uuid()) @db.Uuid
  clinicId      String    @db.Uuid
  lastName      String
  firstName     String
  middleName    String?
  birthDate     DateTime  @db.Date
  sex           Sex
  phone         String
  phone2        String?
  address       String?
  pinflEnc      String?
  pinflHash     String?
  passportEnc   String?
  passportHash  String?
  notes         String?
  bloodGroup    String?
  allergiesText String?
  dhpPatientId  String?
  version       Int       @default(1)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clinic   Clinic           @relation(fields: [clinicId], references: [id])
  consents PatientConsent[]

  @@unique([clinicId, pinflHash])
  @@index([clinicId, passportHash])
  @@index([clinicId, phone])
  @@index([clinicId, lastName, firstName])
  @@index([clinicId, birthDate])
  @@index([clinicId, phone2])
  @@index([lastName(ops: raw("public.gin_trgm_ops"))], type: Gin, map: "patient_last_name_trgm")
  @@index([firstName(ops: raw("public.gin_trgm_ops"))], type: Gin, map: "patient_first_name_trgm")
  @@index([middleName(ops: raw("public.gin_trgm_ops"))], type: Gin, map: "patient_middle_name_trgm")
  @@index([phone(ops: raw("public.gin_trgm_ops"))], type: Gin, map: "patient_phone_trgm")
}

model PatientConsent {
  id               String      @id @default(uuid()) @db.Uuid
  clinicId         String      @db.Uuid
  patientId        String      @db.Uuid
  type             ConsentType
  granted          Boolean
  grantedAt        DateTime    @default(now())
  revokedAt        DateTime?
  recordedByUserId String?     @db.Uuid
  documentUrl      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([patientId, type])
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  FRONT_DESK
  PHONE
  TELEGRAM
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  DONE
  SKIPPED
}

enum ExceptionType {
  DAY_OFF
  CUSTOM_HOURS
}

model ServiceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  nameUz    String
  nameRu    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  @@index([clinicId])
}

model Service {
  id             String    @id @default(uuid()) @db.Uuid
  clinicId       String    @db.Uuid
  categoryId     String?   @db.Uuid
  code           String
  nameUz         String
  nameRu         String
  durationMin    Int       @default(20)
  isLab          Boolean   @default(false)
  isActive       Boolean   @default(true)
  dhpServiceCode String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category      ServiceCategory? @relation(fields: [categoryId], references: [id])
  prices        ServicePrice[]
  doctorService DoctorService[]

  @@unique([clinicId, code])
  @@index([clinicId])
}

model ServicePrice {
  id        String    @id @default(uuid()) @db.Uuid
  clinicId  String    @db.Uuid
  serviceId String    @db.Uuid
  branchId  String    @db.Uuid
  price     BigInt
  validFrom DateTime
  validTo   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  service Service @relation(fields: [serviceId], references: [id])

  @@index([clinicId])
  @@index([serviceId, branchId, validFrom])
}

model DoctorService {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  doctorId  String   @db.Uuid
  serviceId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id])

  @@unique([doctorId, serviceId])
  @@index([clinicId])
}

model DoctorSchedule {
  id          String    @id @default(uuid()) @db.Uuid
  clinicId    String    @db.Uuid
  doctorId    String    @db.Uuid
  branchId    String    @db.Uuid
  weekday     Int // 1 = Monday .. 7 = Sunday
  startTime   String // HH:mm in the branch timezone
  endTime     String
  slotMinutes Int       @default(20)
  validFrom   DateTime  @db.Date
  validTo     DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clinicId])
  @@index([doctorId, branchId, weekday])
}

model ScheduleException {
  id        String        @id @default(uuid()) @db.Uuid
  clinicId  String        @db.Uuid
  doctorId  String        @db.Uuid
  branchId  String        @db.Uuid
  date      DateTime      @db.Date
  type      ExceptionType
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clinicId])
  @@index([doctorId, date])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  clinicId        String            @db.Uuid
  branchId        String            @db.Uuid
  patientId       String            @db.Uuid
  doctorId        String            @db.Uuid
  serviceId       String?           @db.Uuid
  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentStatus @default(BOOKED)
  source          AppointmentSource @default(FRONT_DESK)
  note            String?
  createdByUserId String?           @db.Uuid
  version         Int               @default(1)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  // Double booking is prevented by a btree_gist exclusion constraint added in raw SQL
  // (see migration *_scheduling): EXCLUDE (doctorId WITH =, tstzrange(startsAt, endsAt) WITH &&).

  @@index([clinicId, startsAt])
  @@index([doctorId, startsAt])
  @@index([patientId])
}

model QueueTicket {
  id            String      @id @default(uuid()) @db.Uuid
  clinicId      String      @db.Uuid
  branchId      String      @db.Uuid
  date          String // YYYY-MM-DD in the branch timezone
  number        Int
  patientId     String      @db.Uuid
  doctorId      String?     @db.Uuid
  appointmentId String?     @db.Uuid
  status        QueueStatus @default(WAITING)
  calledAt      DateTime?
  cabinet       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([branchId, date, number])
  @@index([clinicId])
  @@index([branchId, date, status])
}

enum EncounterStatus {
  OPEN
  SIGNED
  CANCELLED
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  COMPLICATION
}

model Encounter {
  id              String          @id @default(uuid()) @db.Uuid
  clinicId        String          @db.Uuid
  branchId        String          @db.Uuid
  patientId       String          @db.Uuid
  doctorId        String          @db.Uuid
  appointmentId   String?         @db.Uuid
  status          EncounterStatus @default(OPEN)
  startedAt       DateTime        @default(now())
  signedAt        DateTime?
  complaints      String?
  anamnesis       String?
  objectiveStatus String?
  conclusion      String?
  recommendations String?
  version         Int             @default(1)
  dhpEncounterId  String?
  dhpSyncStatus   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vitals        Vitals[]
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  addenda       EncounterAddendum[]

  @@index([clinicId, patientId, startedAt])
  @@index([clinicId, doctorId, startedAt])
}

model Vitals {
  id               String   @id @default(uuid()) @db.Uuid
  clinicId         String   @db.Uuid
  encounterId      String   @db.Uuid
  temperature      Float?
  systolic         Int?
  diastolic        Int?
  pulse            Int?
  respRate         Int?
  spo2             Int?
  weightKg         Float?
  heightCm         Float?
  recordedAt       DateTime @default(now())
  recordedByUserId String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([clinicId])
  @@index([encounterId])
}

model Diagnosis {
  id          String        @id @default(uuid()) @db.Uuid
  clinicId    String        @db.Uuid
  encounterId String        @db.Uuid
  icd10Code   String
  title       String
  type        DiagnosisType @default(PRIMARY)
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([clinicId])
  @@index([encounterId])
}

/// Global reference table (not tenant scoped).
model Icd10Code {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  titleUz    String
  titleRu    String
  parentCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([titleRu(ops: raw("public.gin_trgm_ops"))], type: Gin, map: "icd10_title_ru_trgm")
  @@index([titleUz(ops: raw("public.gin_trgm_ops"))], type: Gin, map: "icd10_title_uz_trgm")
}

model Prescription {
  id           String   @id @default(uuid()) @db.Uuid
  clinicId     String   @db.Uuid
  encounterId  String   @db.Uuid
  drugName     String
  form         String?
  dosage       String?
  frequency    String?
  durationDays Int?
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([clinicId])
  @@index([encounterId])
}

model EncounterAddendum {
  id           String   @id @default(uuid()) @db.Uuid
  clinicId     String   @db.Uuid
  encounterId  String   @db.Uuid
  authorUserId String   @db.Uuid
  text         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([clinicId])
  @@index([encounterId])
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String   @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  fileName   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clinicId, entityType, entityId])
}

model TextTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  specialty       String
  title           String
  field           String
  body            String
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clinicId, specialty])
}

enum DhpSyncStatus {
  PENDING
  SENT
  FAILED
  DEAD
  SKIPPED
}

model DhpSyncRecord {
  id            String        @id @default(uuid()) @db.Uuid
  clinicId      String        @db.Uuid
  outboxEventId String        @unique @db.Uuid
  entityType    String
  entityId      String        @db.Uuid
  status        DhpSyncStatus @default(PENDING)
  attempts      Int           @default(0)
  lastError     String?
  remoteId      String?
  syncedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clinicId, status])
  @@index([clinicId, entityType, entityId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  CLICK
  PAYME
  UZUM
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  clinicId        String        @db.Uuid
  branchId        String        @db.Uuid
  patientId       String        @db.Uuid
  encounterId     String?       @db.Uuid
  number          String
  status          InvoiceStatus @default(DRAFT)
  subtotal        BigInt        @default(0)
  discount        BigInt        @default(0)
  total           BigInt        @default(0)
  paidAmount      BigInt        @default(0)
  createdByUserId String        @db.Uuid
  issuedAt        DateTime?
  voidedAt        DateTime?
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@unique([clinicId, number])
  @@index([clinicId, patientId])
  @@index([clinicId, status, createdAt])
}

model InvoiceLine {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @db.Uuid
  invoiceId   String   @db.Uuid
  serviceId   String?  @db.Uuid
  description String
  qty         Int
  unitPrice   BigInt
  discount    BigInt   @default(0)
  total       BigInt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([clinicId])
  @@index([invoiceId])
}

model CashShift {
  id           String      @id @default(uuid()) @db.Uuid
  clinicId     String      @db.Uuid
  branchId     String      @db.Uuid
  cashierId    String      @db.Uuid
  status       ShiftStatus @default(OPEN)
  openingFloat BigInt      @default(0)
  expectedCash BigInt?
  countedCash  BigInt?
  difference   BigInt?
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  payments Payment[]
  refunds  Refund[]

  @@index([clinicId, cashierId, status])
  @@index([clinicId, openedAt])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  clinicId         String        @db.Uuid
  invoiceId        String        @db.Uuid
  method           PaymentMethod
  amount           BigInt
  refundedAmount   BigInt        @default(0)
  idempotencyKey   String
  cashShiftId      String?       @db.Uuid
  receivedByUserId String        @db.Uuid
  providerRef      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  invoice Invoice    @relation(fields: [invoiceId], references: [id])
  shift   CashShift? @relation(fields: [cashShiftId], references: [id])
  refunds Refund[]

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, invoiceId])
  @@index([clinicId, cashShiftId])
}

model Refund {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  paymentId       String   @db.Uuid
  amount          BigInt
  reason          String
  cashShiftId     String?  @db.Uuid
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payment Payment    @relation(fields: [paymentId], references: [id])
  shift   CashShift? @relation(fields: [cashShiftId], references: [id])

  @@index([clinicId, paymentId])
  @@index([clinicId, cashShiftId])
}
