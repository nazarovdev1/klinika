{
  "extends": "@shifo/config/tsconfig.next.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "*.mjs",
    "*.ts",
    ".next/types/**/*.ts",
    "e2e",
    "next-env.d.ts",
    "src",
    ".next-e2e/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
